[sub_resource type="Shader" id="SH_raccoon_chroma"]
code = "shader_type canvas_item;

void fragment() {
	vec4 pixel = texture(TEXTURE, UV);
	vec3 dark_blue = vec3(41.0, 88.0, 124.0) / 255.0;
	vec3 light_blue = vec3(68.0, 145.0, 190.0) / 255.0;
	if (distance(pixel.rgb, dark_blue) < 0.01 || distance(pixel.rgb, light_blue) < 0.01) {
		pixel.a = 0.0;
	}
	COLOR = pixel;
}
"

