[sub_resource type="Shader" id="SH_chroma"]
code = "shader_type canvas_item;
void fragment() {
	vec4 p = texture(TEXTURE, UV);
	vec3 bg1 = vec3(68.0, 145.0, 190.0) / 255.0;
	vec3 bg2 = vec3(41.0, 88.0, 124.0) / 255.0;
	if (distance(p.rgb, bg1) < 0.05 || distance(p.rgb, bg2) < 0.05) {
		p.a = 0.0;
	}
	COLOR = p;
}"

